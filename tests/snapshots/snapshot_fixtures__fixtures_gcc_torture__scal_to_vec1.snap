                                    if %329 {
                                        call @abort() [all]
                                        yield
                                    }
                                    yield
                                }
                                yield
                            }
                            yield
                        }
                        yield
                    }
                    yield
                }
                yield
            } while {
                %315 = const 0 : s32i
                %316 = cast(int_to_bool) %315 : bool
                condition %316
            }
            yield
        }
        %313 = const 0 : s32i
        store %313, %2
        %314 = load %2 : s32i
        return %314
}
