            %31 = load %1 : s32i, align 4
            %32 = const 32 : s32i
            %33 = cmp lt %31, %32 : bool
            condition %33
        } step: {
            %8 = load %1 : s32i, align 4
            %9 = inc %8 : s32i [nsw]
            store %9, %1, align 4
            yield
        } do {
            scope {
                %10 = load %1 : s32i, align 4
                %11 = cast(integral) %10 : s64i
                %12 = get_global @gd : double[32]*
                %13 = get_element %12[%11] : double*
                %14 = load %13 : double, align 8, volatile
                %15 = load %1 : s32i, align 4
                %16 = const 4 : s32i
                %17 = mul %15, %16 : s32i [nsw]
                %18 = cast(int_to_float) %17 : double
                %19 = cmp ne %14, %18 : bool
                %20 = ternary %19 ? { : bool
                    %30 = const #true : bool
                    yield %30
                } : {
                    %22 = load %1 : s32i, align 4
                    %23 = cast(integral) %22 : s64i
                    %24 = get_global @gf : float[32]*
                    %25 = get_element %24[%23] : float*
                    %26 = load %25 : float, align 4, volatile
                    %27 = load %1 : s32i, align 4
                    %28 = cast(int_to_float) %27 : float
                    %29 = cmp ne %26, %28 : bool
                    yield %29
                }
                if %20 {
                    %21 = get_global @abort : (() -> void)*
                    call @abort() [all]
                    yield
                }
                yield
            }
            yield
        }
        yield
    }
    %4 = get_global @exit : ((s32i) -> void)*
    %5 = const 0 : s32i
    call @exit(%5) [all]
    %6 = load %0 : s32i
    return %6
}
