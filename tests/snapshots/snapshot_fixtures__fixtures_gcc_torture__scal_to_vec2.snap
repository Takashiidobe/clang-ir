                                    %119 = call @vchr() : s8i [all]
                                    %120 = cast(integral) %119 : s64i
                                    %121 = cast(bitcast) %9 : s64i*
                                    %122 = load %110 : s32i, align 4
                                    %123 = ptr_stride %121, %122 : s64i*
                                    %124 = load %123 : s64i, align 8
                                    %125 = mul %120, %124 : s64i [nsw]
                                    %126 = cmp ne %117, %125 : bool
                                    if %126 {
                                        call @abort() [all]
                                        yield
                                    }
                                    yield
                                }
                                yield
                            }
                            yield
                        }
                        yield
                    }
                    yield
                }
                yield
            } while {
                %108 = const 0 : s32i
                %109 = cast(int_to_bool) %108 : bool
                condition %109
            }
            yield
        }
        %106 = const 0 : s32i
        store %106, %2
        %107 = load %2 : s32i
        return %107
}
